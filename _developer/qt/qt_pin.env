# Qt SDK version used by the local and CI setup scripts. The setup script
# verifies the package revision before installing the SDK.
QT_VERSION=6.12.0
QT_PACKAGE_REVISION=202609280346
QT_SOURCE_FLOOR=6.12
AQTINSTALL_VERSION=3.3.0
PY7ZR_VERSION=1.0.0
QT_MODULES="qtmultimedia qtshadertools"

# Minimum host versions for the pinned prebuilt Qt SDK.
QT_MIN_GLIBC_X86_64=2.34
QT_MIN_GLIBC_AARCH64=2.38
QT_MIN_MACOS=14.4
QT_MIN_XCODE=16
